APP_ENV=local

POSTGRES_DB=datamask
POSTGRES_USER=datamask
POSTGRES_PASSWORD=replace-with-a-long-random-secret

RABBITMQ_USER=datamask
RABBITMQ_PASSWORD=replace-with-a-different-long-random-secret

DATABASE_URL=postgresql+psycopg://datamask:replace-with-a-long-random-secret@postgres:5432/datamask
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://datamask:replace-with-a-different-long-random-secret@rabbitmq:5672/%2F

# Authentication - replace placeholders with generated RSA keys
JWT_PRIVATE_KEY_B64=replace-with-base64-private-key
JWT_PUBLIC_KEY_B64=replace-with-base64-public-key
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
